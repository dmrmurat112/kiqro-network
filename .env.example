DATABASE_URL=postgres://kiqro:kiqro_dev@localhost:5432/kiqro
TEST_DATABASE_URL=postgres://kiqro:kiqro_dev@localhost:5432/kiqro_test
PORT=4000
# Public base URL of the tracking service, used when building click URLs.
TRACKING_BASE_URL=http://localhost:4000
# proxycheck.io key for VPN/proxy/datacenter detection (leave empty to disable)
PROXYCHECK_API_KEY=
# E-mail (SendGrid). Without SENDGRID_API_KEY, e-mails are printed to the worker console.
SENDGRID_API_KEY=
# Must be on a domain authenticated in SendGrid (Settings → Sender Authentication).
MAIL_FROM=noreply@kiqro.com
MAIL_FROM_NAME=Kiqro Network
MAIL_REPLY_TO=contact@kiqro.com
# true = SendGrid validates requests without delivering (for testing a key)
SENDGRID_SANDBOX=false
# Sales inbox for demo requests from the site
LEADS_NOTIFY_EMAIL=contact@kiqro.com
# Public URLs used in e-mail links
ADVERTISE_BASE_URL=http://localhost:4200
ADMIN_BASE_URL=http://localhost:4100
# Require advertiser panel users to accept the current Advertiser Terms (turn on once the
# lawyer-approved terms are published; the terms version lives in apps/advertise/src/content/legal/terms.ts)
TERMS_REQUIRED=false
# Inbox notified when an advertiser submits a campaign for review (defaults to LEADS_NOTIFY_EMAIL)
REVIEW_NOTIFY_EMAIL=
# Stripe (card top-ups in the advertiser panel). Use test keys (sk_test_…) outside production.
# Without STRIPE_SECRET_KEY, development uses a stand-in checkout page (/app/billing/dev-checkout)
# and production shows card payments as unavailable.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint {ADVERTISE_BASE_URL}/api/stripe/webhook (whsec_…)
STRIPE_WEBHOOK_SECRET=
# Cloudflare adds X-Origin-Auth with this value; when set, the tracking service refuses requests without it
ORIGIN_SECRET=
